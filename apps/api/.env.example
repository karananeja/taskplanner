# SQLite file, relative to apps/api
DATABASE_URL="file:./dev.db"
PORT=4000
# Where the web app runs. The API is reached through Vite's /api proxy, so cookies stay same-origin.
WEB_ORIGIN="http://localhost:3000"
# Optional: Google sign-in. Create an OAuth client (Web application) in Google Cloud Console and add
# http://localhost:3000/api/auth/google/callback as an authorised redirect URI.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
